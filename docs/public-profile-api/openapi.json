{
  "openapi": "3.1.0",
  "info": {
    "title": "Published profile API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/public/v1/profiles/{handle}": {
      "parameters": [
        {
          "name": "handle",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "summary": "Read the current published profile",
        "security": [],
        "responses": {
          "200": {
            "description": "Current immutable snapshot. Cache-Control: no-store. Credential-free CORS.",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "apiVersion": {
                      "type": "number",
                      "const": 1
                    },
                    "handle": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{2,62}$"
                    },
                    "revision": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "revisionCreatedAt": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
                    },
                    "links": {
                      "type": "object",
                      "properties": {
                        "profile": {
                          "type": "string",
                          "pattern": "^\\/people\\/[a-z][a-z0-9-]{2,62}$"
                        },
                        "pdf": {
                          "type": "string",
                          "pattern": "^\\/people\\/[a-z][a-z0-9-]{2,62}\\/resume\\.pdf$"
                        }
                      },
                      "required": [
                        "profile",
                        "pdf"
                      ],
                      "additionalProperties": false
                    },
                    "profile": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 500
                        },
                        "title": {
                          "type": "string",
                          "maxLength": 500
                        },
                        "summary": {
                          "type": "string",
                          "maxLength": 4000
                        },
                        "email": {
                          "type": "string",
                          "maxLength": 320,
                          "format": "email",
                          "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                        },
                        "phone": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 80
                        },
                        "location": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 240
                        },
                        "links": {
                          "maxItems": 30,
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "label": {
                                "type": "string",
                                "maxLength": 120
                              },
                              "url": {
                                "type": "string",
                                "maxLength": 2000,
                                "format": "uri"
                              }
                            },
                            "required": [
                              "label",
                              "url"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "experience": {
                          "maxItems": 50,
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "role": {
                                "type": "string",
                                "maxLength": 500
                              },
                              "company": {
                                "type": "string",
                                "maxLength": 500
                              },
                              "start": {
                                "type": "string",
                                "maxLength": 80
                              },
                              "end": {
                                "type": "string",
                                "maxLength": 80
                              },
                              "summary": {
                                "type": "string",
                                "maxLength": 4000
                              },
                              "bullets": {
                                "maxItems": 40,
                                "type": "array",
                                "items": {
                                  "type": "string",
                                  "maxLength": 4000
                                }
                              },
                              "projects": {
                                "maxItems": 20,
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "name": {
                                      "type": "string",
                                      "maxLength": 4000
                                    },
                                    "summary": {
                                      "type": "string",
                                      "maxLength": 4000
                                    },
                                    "url": {
                                      "type": "string",
                                      "maxLength": 2000,
                                      "format": "uri"
                                    }
                                  },
                                  "required": [
                                    "name",
                                    "summary"
                                  ],
                                  "additionalProperties": false
                                }
                              }
                            },
                            "required": [
                              "role",
                              "company",
                              "start",
                              "end",
                              "bullets",
                              "projects"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "education": {
                          "maxItems": 30,
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "institution": {
                                "type": "string",
                                "maxLength": 500
                              },
                              "credential": {
                                "type": "string",
                                "maxLength": 500
                              },
                              "start": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 4000
                              },
                              "end": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 4000
                              },
                              "summary": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 4000
                              }
                            },
                            "required": [
                              "institution",
                              "credential"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "other": {
                          "maxItems": 30,
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "label": {
                                "type": "string",
                                "maxLength": 240
                              },
                              "value": {
                                "type": "string",
                                "maxLength": 4000
                              }
                            },
                            "required": [
                              "label",
                              "value"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "skills": {
                          "maxItems": 30,
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "label": {
                                "type": "string",
                                "maxLength": 240
                              },
                              "skills": {
                                "maxItems": 100,
                                "type": "array",
                                "items": {
                                  "type": "string",
                                  "maxLength": 120
                                }
                              }
                            },
                            "required": [
                              "label",
                              "skills"
                            ],
                            "additionalProperties": false
                          }
                        }
                      },
                      "required": [
                        "name",
                        "title",
                        "summary",
                        "links",
                        "experience",
                        "education",
                        "other",
                        "skills"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "apiVersion",
                    "handle",
                    "revision",
                    "revisionCreatedAt",
                    "links",
                    "profile"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "404": {
            "description": "Typed PROFILE_UNAVAILABLE (absent, invalid, withdrawn, deleted or disabled)",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "apiVersion": {
                      "type": "number",
                      "const": 1
                    },
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string",
                          "enum": [
                            "PROFILE_UNAVAILABLE",
                            "PROFILE_SERVICE_UNAVAILABLE"
                          ]
                        },
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "code",
                        "message"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "apiVersion",
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "503": {
            "description": "Operational failure; preserve previously built site",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "apiVersion": {
                      "type": "number",
                      "const": 1
                    },
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string",
                          "enum": [
                            "PROFILE_UNAVAILABLE",
                            "PROFILE_SERVICE_UNAVAILABLE"
                          ]
                        },
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "code",
                        "message"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "apiVersion",
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      },
      "head": {
        "summary": "GET status and headers, without body",
        "security": [],
        "responses": {
          "200": {
            "description": "Current profile"
          },
          "404": {
            "description": "Profile unavailable"
          },
          "503": {
            "description": "Operational failure"
          }
        }
      },
      "options": {
        "summary": "Credential-free preflight, no profile lookup",
        "security": [],
        "responses": {
          "204": {
            "description": "Allows GET, HEAD, OPTIONS; Access-Control-Allow-Origin: *; no credentials"
          }
        }
      }
    }
  }
}
