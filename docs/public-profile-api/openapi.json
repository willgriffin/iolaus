{
  "openapi": "3.1.0",
  "info": {
    "title": "Published profile API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/public/v1/profiles/{handle}": {
      "parameters": [
        {
          "name": "handle",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "summary": "Read the current published profile",
        "security": [],
        "responses": {
          "200": {
            "description": "Current immutable snapshot. Cache-Control: no-store. Credential-free CORS.",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "apiVersion": {
                      "type": "number",
                      "const": 1
                    },
                    "handle": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{2,62}$"
                    },
                    "revision": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "revisionCreatedAt": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
                    },
                    "links": {
                      "type": "object",
                      "properties": {
                        "profile": {
                          "type": "string",
                          "pattern": "^\\/people\\/[a-z][a-z0-9-]{2,62}$"
                        },
                        "pdf": {
                          "type": "string",
                          "pattern": "^\\/people\\/[a-z][a-z0-9-]{2,62}\\/resume\\.pdf$"
                        },
                        "chat": {
                          "type": "string",
                          "pattern": "^\\/api\\/public\\/v1\\/profiles\\/[a-z][a-z0-9-]{2,62}\\/chat$"
                        },
                        "voice": {
                          "type": "string",
                          "pattern": "^\\/api\\/public\\/v1\\/profiles\\/[a-z][a-z0-9-]{2,62}\\/voice$"
                        }
                      },
                      "required": [
                        "profile",
                        "pdf"
                      ],
                      "additionalProperties": false
                    },
                    "profile": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 500
                        },
                        "title": {
                          "type": "string",
                          "maxLength": 500
                        },
                        "summary": {
                          "type": "string",
                          "maxLength": 4000
                        },
                        "email": {
                          "type": "string",
                          "maxLength": 320,
                          "format": "email",
                          "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                        },
                        "phone": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 80
                        },
                        "location": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 240
                        },
                        "links": {
                          "maxItems": 30,
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "label": {
                                "type": "string",
                                "maxLength": 120
                              },
                              "url": {
                                "type": "string",
                                "maxLength": 2000,
                                "format": "uri"
                              }
                            },
                            "required": [
                              "label",
                              "url"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "experience": {
                          "maxItems": 50,
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "role": {
                                "type": "string",
                                "maxLength": 500
                              },
                              "company": {
                                "type": "string",
                                "maxLength": 500
                              },
                              "start": {
                                "type": "string",
                                "maxLength": 80
                              },
                              "end": {
                                "type": "string",
                                "maxLength": 80
                              },
                              "summary": {
                                "type": "string",
                                "maxLength": 4000
                              },
                              "bullets": {
                                "maxItems": 40,
                                "type": "array",
                                "items": {
                                  "type": "string",
                                  "maxLength": 4000
                                }
                              },
                              "projects": {
                                "maxItems": 20,
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "name": {
                                      "type": "string",
                                      "maxLength": 4000
                                    },
                                    "summary": {
                                      "type": "string",
                                      "maxLength": 4000
                                    },
                                    "url": {
                                      "type": "string",
                                      "maxLength": 2000,
                                      "format": "uri"
                                    }
                                  },
                                  "required": [
                                    "name",
                                    "summary"
                                  ],
                                  "additionalProperties": false
                                }
                              }
                            },
                            "required": [
                              "role",
                              "company",
                              "start",
                              "end",
                              "bullets",
                              "projects"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "education": {
                          "maxItems": 30,
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "institution": {
                                "type": "string",
                                "maxLength": 500
                              },
                              "credential": {
                                "type": "string",
                                "maxLength": 500
                              },
                              "start": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 4000
                              },
                              "end": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 4000
                              },
                              "summary": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 4000
                              }
                            },
                            "required": [
                              "institution",
                              "credential"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "other": {
                          "maxItems": 30,
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "label": {
                                "type": "string",
                                "maxLength": 240
                              },
                              "value": {
                                "type": "string",
                                "maxLength": 4000
                              }
                            },
                            "required": [
                              "label",
                              "value"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "skills": {
                          "maxItems": 30,
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "label": {
                                "type": "string",
                                "maxLength": 240
                              },
                              "skills": {
                                "maxItems": 100,
                                "type": "array",
                                "items": {
                                  "type": "string",
                                  "maxLength": 120
                                }
                              }
                            },
                            "required": [
                              "label",
                              "skills"
                            ],
                            "additionalProperties": false
                          }
                        }
                      },
                      "required": [
                        "name",
                        "title",
                        "summary",
                        "links",
                        "experience",
                        "education",
                        "other",
                        "skills"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "apiVersion",
                    "handle",
                    "revision",
                    "revisionCreatedAt",
                    "links",
                    "profile"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "404": {
            "description": "Typed PROFILE_UNAVAILABLE (absent, invalid, withdrawn, deleted or disabled)",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "apiVersion": {
                      "type": "number",
                      "const": 1
                    },
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string",
                          "enum": [
                            "PROFILE_UNAVAILABLE",
                            "PROFILE_SERVICE_UNAVAILABLE"
                          ]
                        },
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "code",
                        "message"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "apiVersion",
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "503": {
            "description": "Operational failure; preserve previously built site",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "apiVersion": {
                      "type": "number",
                      "const": 1
                    },
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string",
                          "enum": [
                            "PROFILE_UNAVAILABLE",
                            "PROFILE_SERVICE_UNAVAILABLE"
                          ]
                        },
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "code",
                        "message"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "apiVersion",
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      },
      "head": {
        "summary": "GET status and headers, without body",
        "security": [],
        "responses": {
          "200": {
            "description": "Current profile"
          },
          "404": {
            "description": "Profile unavailable"
          },
          "503": {
            "description": "Operational failure"
          }
        }
      },
      "options": {
        "summary": "Credential-free preflight, no profile lookup",
        "security": [],
        "responses": {
          "204": {
            "description": "Allows GET, HEAD, OPTIONS; Access-Control-Allow-Origin: *; no credentials"
          }
        }
      }
    },
    "/api/public/v1/profiles/{handle}/chat": {
      "post": {
        "summary": "Ask the published profile a question; the reply is grounded only in the published snapshot.",
        "description": "Anonymous. Browser requests must send an Origin listed in IOLAUS_PUBLIC_ASSISTANT_ORIGINS. Per client address 12 questions per 10 minutes; per handle 120 per 10 minutes. Replies are capped at 350 output tokens.",
        "parameters": [
          {
            "name": "handle",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{2,62}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "messages"
                ],
                "properties": {
                  "messages": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 12,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "role",
                        "content"
                      ],
                      "properties": {
                        "role": {
                          "type": "string",
                          "enum": [
                            "user",
                            "assistant"
                          ]
                        },
                        "content": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 1000
                        }
                      }
                    }
                  }
                },
                "description": "Bounded history, newest last; the last message must be from the visitor."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Server-sent events: `data: {\"token\": \"…\"}` frames followed by one `data: {\"done\": true, \"text\": \"…\"}`.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request body or offer (400), origin not allowed (403), profile unavailable or feature disabled (404), offer too large (413), unsupported media type (415), window or concurrency limit (429), provider failure (502), service or voice unavailable (503).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantError"
                }
              }
            }
          },
          "403": {
            "description": "Typed assistant error; never includes internal details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantError"
                }
              }
            }
          },
          "404": {
            "description": "Typed assistant error; never includes internal details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantError"
                }
              }
            }
          },
          "413": {
            "description": "Typed assistant error; never includes internal details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantError"
                }
              }
            }
          },
          "415": {
            "description": "Typed assistant error; never includes internal details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantError"
                }
              }
            }
          },
          "429": {
            "description": "Typed assistant error; never includes internal details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantError"
                }
              }
            }
          },
          "502": {
            "description": "Typed assistant error; never includes internal details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantError"
                }
              }
            }
          },
          "503": {
            "description": "Typed assistant error; never includes internal details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantError"
                }
              }
            }
          }
        }
      },
      "options": {
        "summary": "CORS preflight for an allow-listed origin.",
        "parameters": [
          {
            "name": "handle",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{2,62}$"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Allowed origin; echoes access-control-allow-origin, never *."
          },
          "403": {
            "description": "Typed assistant error; never includes internal details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantError"
                }
              }
            }
          },
          "404": {
            "description": "Typed assistant error; never includes internal details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantError"
                }
              }
            }
          }
        }
      }
    },
    "/api/public/v1/profiles/{handle}/voice": {
      "post": {
        "summary": "Open a bounded WebRTC voice call with the published profile.",
        "description": "Anonymous; requires the deployment's dedicated voice key. Per client address 4 calls per hour; per handle 12 call starts per hour across all addresses; 3 concurrent calls per replica; the call is hung up after x-voice-seconds. The same Origin allowlist applies.",
        "parameters": [
          {
            "name": "handle",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{2,62}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/sdp": {
              "schema": {
                "type": "string",
                "maxLength": 65536,
                "description": "WebRTC SDP offer with an audio media section (starts with v=0)."
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "SDP answer for the offer.",
            "headers": {
              "x-voice-seconds": {
                "description": "Hard call length in seconds; the server hangs up afterwards.",
                "schema": {
                  "type": "integer"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/sdp": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request body or offer (400), origin not allowed (403), profile unavailable or feature disabled (404), offer too large (413), unsupported media type (415), window or concurrency limit (429), provider failure (502), service or voice unavailable (503).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantError"
                }
              }
            }
          },
          "403": {
            "description": "Typed assistant error; never includes internal details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantError"
                }
              }
            }
          },
          "404": {
            "description": "Typed assistant error; never includes internal details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantError"
                }
              }
            }
          },
          "413": {
            "description": "Typed assistant error; never includes internal details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantError"
                }
              }
            }
          },
          "415": {
            "description": "Typed assistant error; never includes internal details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantError"
                }
              }
            }
          },
          "429": {
            "description": "Typed assistant error; never includes internal details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantError"
                }
              }
            }
          },
          "502": {
            "description": "Typed assistant error; never includes internal details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantError"
                }
              }
            }
          },
          "503": {
            "description": "Typed assistant error; never includes internal details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantError"
                }
              }
            }
          }
        }
      },
      "options": {
        "summary": "CORS preflight for an allow-listed origin.",
        "parameters": [
          {
            "name": "handle",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{2,62}$"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Allowed origin; echoes access-control-allow-origin, never *."
          },
          "403": {
            "description": "Typed assistant error; never includes internal details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantError"
                }
              }
            }
          },
          "404": {
            "description": "Typed assistant error; never includes internal details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AssistantError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "apiVersion",
          "error"
        ],
        "properties": {
          "apiVersion": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "ASSISTANT_UNAVAILABLE"
                ]
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
