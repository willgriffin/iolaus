{
  "$schema": "https://biomejs.dev/schemas/2.4.12/schema.json",
  "files": {
    "includes": [
      "apps/*/src/**/*.{js,ts,tsx,jsx,svelte}",
      "apps/site/scripts/db-doctor.ts",
      "apps/site/scripts/db-export.ts",
      "apps/site/scripts/db-import.ts",
      "apps/site/scripts/db-reset-local.ts",
      "apps/site/scripts/db-snapshot*.ts",
      "apps/site/scripts/db-status.ts",
      "apps/*/*.{js,ts,json,jsonc}",
      "packages/*/src/**/*.{js,ts,tsx,jsx,svelte}",
      "packages/*/scripts/**/*.{js,ts}",
      "packages/*/*.{js,ts,json,jsonc}",
      ".github/**/*.{js,ts}",
      "scripts/**/*.{js,ts}",
      "*.{js,ts,json,jsonc}"
    ],
    "ignoreUnknown": true
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "info",
        "noArrayIndexKey": "warn",
        "noImplicitAnyLet": "warn"
      },
      "correctness": {
        "noUnusedVariables": "warn",
        "noUnusedImports": "warn",
        "useParseIntRadix": "warn"
      },
      "style": {
        "noNonNullAssertion": "warn",
        "useNamingConvention": {
          "level": "warn",
          "options": {
            "strictCase": false,
            "conventions": [
              {
                "selector": {
                  "kind": "interface"
                },
                "formats": ["PascalCase"]
              },
              {
                "selector": {
                  "kind": "typeAlias"
                },
                "formats": ["PascalCase"]
              },
              {
                "selector": {
                  "kind": "class"
                },
                "formats": ["PascalCase"]
              },
              {
                "selector": {
                  "kind": "enumMember"
                },
                "formats": ["CONSTANT_CASE"]
              },
              {
                "selector": {
                  "kind": "function"
                },
                "formats": ["camelCase"]
              },
              {
                "selector": {
                  "kind": "variable"
                },
                "formats": ["camelCase", "CONSTANT_CASE", "PascalCase"]
              }
            ]
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "overrides": [
    {
      "includes": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/test/**/*.ts",
        "**/test/**/*.tsx",
        "**/tests/**/*.ts",
        "**/tests/**/*.tsx",
        "**/__tests__/**/*.ts",
        "**/__tests__/**/*.tsx",
        "**/mock-*.ts",
        "**/test-*.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off",
            "noArrayIndexKey": "off"
          },
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off",
            "noUnusedFunctionParameters": "off"
          },
          "style": {
            "useNamingConvention": "off"
          },
          "complexity": {
            "noStaticOnlyClass": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.svelte"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          },
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          },
          "style": {
            "useNamingConvention": "off",
            "useConst": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/site/scripts/**/*.{js,ts}"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off"
          },
          "suspicious": {
            "noAssignInExpressions": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/site/src/app.d.ts",
        "apps/site/src/lib/objects/lifecycle.ts",
        "apps/site/src/lib/server/auth.ts",
        "apps/site/src/lib/server/application-workflow.ts",
        "apps/site/src/lib/server/opportunity-details.ts",
        "apps/site/src/lib/server/opportunity-source-crawler.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/*.config.{js,ts}",
        "**/vite.config.ts",
        "**/svelte.config.js"
      ],
      "linter": {
        "rules": {
          "suspicious": { "noExplicitAny": "off" },
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedFunctionParameters": "off"
          }
        }
      }
    }
  ]
}
