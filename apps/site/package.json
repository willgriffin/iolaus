{
  "name": "@willgriffin/iolaus-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && tsx scripts/smoke-built-admin.ts",
    "preview": "node build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run --exclude 'src/lib/components/sources/*.browser.spec.ts' && pnpm test:browser",
    "test:browser": "vitest --config vitest.browser.config.ts run",
    "test:source-crawl-quarantine:db": "SOURCE_CRAWL_ITEM_QUARANTINE_DB=1 vitest run src/lib/server/source-crawl-item-quarantine.integration.spec.ts",
    "test:data-surface-store:db": "DATA_SURFACE_STORE_TEST_DATABASE_URL=${DATA_SURFACE_STORE_TEST_DATABASE_URL:-$DATABASE_URL} vitest run src/lib/server/data-surface-action-state-store.integration.spec.ts",
    "test:source-crawl-integrity:db": "SOURCE_CRAWL_INTEGRITY_DB=1 vitest run src/lib/server/source-crawl-opportunity-integrity.integration.spec.ts",
    "test:opportunity-llm-repro": "vitest run src/lib/server/opportunity-llm-live.integration.spec.ts",
    "test:opportunities-perf": "OPPORTUNITY_LIST_PERF=1 vitest run src/lib/server/admin-opportunity-query.integration.spec.ts",
    "data": "tsx scripts/data-cli.ts",
    "demo:fixture": "tsx scripts/demo-fixture.ts",
    "db:doctor": "tsx scripts/db-doctor.ts",
    "db:export": "tsx scripts/db-export.ts",
    "db:export-prod": "tsx scripts/db-export.ts --prod",
    "db:import": "tsx scripts/db-import.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:repair-tag-integrity": "tsx scripts/db-repair-tag-integrity.ts",
    "db:repair-source-crawl-opportunities": "tsx scripts/db-repair-source-crawl-opportunities.ts",
    "db:quarantine-source-crawl-item": "tsx scripts/db-quarantine-source-crawl-item.ts",
    "db:recover-source-crawl-parent": "tsx scripts/db-recover-source-crawl-parent.ts",
    "db:verify-backup": "tsx scripts/db-verify-backup.ts",
    "db:reset-local": "tsx scripts/db-reset-local.ts",
    "db:status": "tsx scripts/db-status.ts",
    "db:backfill-smrt-native": "tsx scripts/backfill-smrt-native.ts",
    "jobs:worker": "tsx scripts/jobs-worker.ts",
    "opportunities:crawl": "tsx scripts/crawl-opportunity-sources.ts",
    "opportunities:crawl-status": "tsx scripts/source-crawl-status.ts",
    "opportunities:intelligence-canary": "tsx scripts/opportunity-intelligence-canary.ts",
    "opportunities:intelligence-control": "tsx scripts/opportunity-intelligence-control.ts",
    "skills:sweep": "tsx scripts/sweep-resume-skills.ts",
    "mcp:generate": "tsx scripts/generate-mcp.ts",
    "mcp": "tsx scripts/mcp-server.ts",
    "smrt:data": "tsx scripts/data-cli.ts"
  },
  "dependencies": {
    "@happyvertical/ai": "0.79.0",
    "@happyvertical/auth": "0.76.2",
    "@happyvertical/files": "0.76.2",
    "@happyvertical/pdf": "0.65.9",
    "@happyvertical/smrt-agents": "0.45.0",
    "@happyvertical/smrt-app-runtime": "0.45.0",
    "@happyvertical/smrt-config": "0.45.0",
    "@happyvertical/smrt-core": "0.45.0",
    "@happyvertical/smrt-facts": "0.45.0",
    "@happyvertical/smrt-jobs": "0.45.0",
    "@happyvertical/smrt-places": "0.45.0",
    "@happyvertical/smrt-profiles": "0.45.0",
    "@happyvertical/smrt-svelte": "0.45.0",
    "@happyvertical/smrt-tags": "0.45.0",
    "@happyvertical/smrt-tenancy": "0.45.0",
    "@happyvertical/smrt-ui": "0.45.0",
    "@happyvertical/smrt-users": "0.45.0",
    "@happyvertical/smrt-web": "0.45.0",
    "@happyvertical/spider": "1.1.11",
    "@happyvertical/sql": "0.89.4",
    "@lucide/svelte": "^1.16.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@willgriffin/iolaus-resume": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "catalog:",
    "@sveltejs/kit": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@types/node": "catalog:",
    "playwright-core": "1.61.1",
    "svelte": "catalog:",
