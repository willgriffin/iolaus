{
  "name": "@willgriffin/iolaus",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "files": [
    "AGENTS.md",
    "CLAUDE.md"
  ],
  "engines": {
    "node": ">=26.10.0",
    "pnpm": ">=11.25.0"
  },
  "scripts": {
    "app:install": "node scripts/smrt-app.mjs install",
    "app:setup": "node scripts/smrt-app.mjs setup",
    "app:recover": "node scripts/smrt-app.mjs recover",
    "app:start": "node scripts/smrt-app.mjs start",
    "app:doctor": "node scripts/smrt-app.mjs doctor",
    "app:open": "node scripts/smrt-app.mjs open",
    "app:stop": "node scripts/smrt-app.mjs stop",
    "app:backup": "node scripts/smrt-app.mjs backup",
    "app:export": "node scripts/smrt-app.mjs export",
    "app:import": "node scripts/smrt-app.mjs import",
    "daily:up": "node scripts/daily-use-dev.mjs up",
    "daily:down": "node scripts/daily-use-dev.mjs down",
    "daily:migrate": "node scripts/daily-use-dev.mjs migrate",
    "daily:dev": "node scripts/daily-use-dev.mjs dev",
    "daily:doctor": "node scripts/daily-use-dev.mjs doctor",
    "daily:start": "node scripts/daily-use-dev.mjs start",
    "daily:stop": "node scripts/daily-use-dev.mjs stop",
    "daily:status": "node scripts/daily-use-dev.mjs status",
    "daily:backup": "node scripts/daily-use-dev.mjs backup",
    "demo:prepare": "node scripts/iolaus-demo.mjs prepare",
    "demo:smoke": "node scripts/iolaus-demo.mjs smoke",
    "demo:status": "node scripts/iolaus-demo.mjs status",
    "demo:reset": "node scripts/iolaus-demo.mjs reset",
    "demo:test": "node --test scripts/iolaus-demo.spec.mjs",
    "worker": "node scripts/smrt-worker.mjs task",
    "worker:schedule": "node scripts/smrt-worker.mjs schedule",
    "deploy:self-hosted:check": "node scripts/check-self-hosted-manifests.mjs",
    "parity:contract": "node scripts/deployed-parity.mjs",
    "prepare": "git rev-parse --git-dir > /dev/null 2>&1 && lefthook install || echo 'Skipping lefthook install (not in git repository)'",
    "build": "turbo run build",
    "check": "turbo run check",
    "dev": "turbo run dev",
    "lint": "biome check . && node scripts/check-npmrc-credentials.mjs",
    "lint:fix": "biome check --write .",
    "test": "node --test scripts/*.test.mjs && turbo run test && pnpm deploy:self-hosted:check",
    "format": "biome check --write .",
    "format-check": "biome ci --diagnostic-level=error .",
    "format:check": "pnpm format-check",
    "knowledge:check": "smrt knowledge:check --strict --format markdown",
    "knowledge:check:json": "smrt knowledge:check --strict --format json",
    "knowledge:review-context": "smrt knowledge:review-context --scope project --format markdown",
    "knowledge:review-context:json": "smrt knowledge:review-context --scope project --format json",
    "knowledge:architecture-context": "smrt knowledge:architecture-context --scope project --format markdown",
    "knowledge:architecture-context:json": "smrt knowledge:architecture-context --scope project --format json",
    "smrt:dev-mcp": "smrt-dev-mcp",
    "typecheck": "pnpm check",
    "clean": "turbo run clean",
    "test:e2e": "pnpm --filter @willgriffin/iolaus-site exec playwright test",
    "test:e2e:check": "pnpm --filter @willgriffin/iolaus-site exec tsc --noEmit -p tsconfig.e2e.json",
    "matching:evaluate": "node scripts/matching-evaluation/run.mjs",
    "matching:evaluate:test": "node --test scripts/matching-evaluation.test.mjs",
    "desktop:bundle": "node scripts/desktop.mjs bundle",
    "desktop:build": "node scripts/desktop.mjs build",
    "desktop:install": "node scripts/desktop.mjs install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@happyvertical/encryption": "0.113.1",
    "@happyvertical/smrt-cli": "0.62.1",
    "@happyvertical/smrt-dev-mcp": "0.62.1",
    "lefthook": "2.1.10",
    "turbo": "2.10.5",
    "typescript": "5.9.3",
    "@happyvertical/smrt-desktop": "0.62.1",
    "@tauri-apps/cli": "2.12.4",
    "@happyvertical/smrt-app-cli": "0.62.1",
    "esbuild": "0.27.4"
  },
  "dependencies": {
    "@happyvertical/smrt-app-runtime": "0.62.1",
    "@happyvertical/smrt-config": "0.62.1",
    "@happyvertical/smrt-scanner": "0.62.1",
    "@happyvertical/speech": "0.113.1",
    "@happyvertical/sql": "0.113.1",
    "tsx": "catalog:"
  },
  "license": "MIT"
}
