# Local is the safe default. Iolaus stores SQLite, assets, secrets and runtime
# state in the operating system's user-owned application-data directory.
SMRT_RUNTIME_PROFILE=local
SMRT_APP_ID=iolaus
IOLAUS_APP_NAME=Iolaus
# SMRT_DATA_DIR=/absolute/user-owned/iolaus-data
HOST=127.0.0.1
PORT=5173
SMRT_BACKGROUND_JOBS=false

# Self-hosted deployments opt in explicitly and provide PostgreSQL plus public
# authentication/storage providers.
# SMRT_RUNTIME_PROFILE=self-hosted
# SMRT_APP_ID=my-unique-career-hub
# IOLAUS_PUBLIC_URL=https://jobs.example.com
# Exact immediate MCP Apps host origin. Never derive this from a browser request.
# IOLAUS_MCP_HOST_ORIGIN=https://trusted-host.example.com
# Optional OAuth 2.1 access-token validation for the public MCP endpoint.
# All three values are required together; the endpoint stays cookie/CLI-only otherwise.
# IOLAUS_MCP_OAUTH_JWKS_URI=https://identity.example.com/realms/your-realm/protocol/openid-connect/certs
# IOLAUS_MCP_OAUTH_SCOPES=iolaus.mcp
# IOLAUS_MCP_OAUTH_ALGORITHMS=RS256
# IOLAUS_MCP_OAUTH_TOKEN_TYPE=at+jwt
# IOLAUS_OIDC_SERVER_URL=https://identity.example.com
# IOLAUS_OIDC_REALM=your-realm
# IOLAUS_OIDC_CLIENT_ID=iolaus
# Private is the default; shared gives each verified user a separate tenant.
# IOLAUS_WORKSPACE_MODE=private
# IOLAUS_OIDC_ADMIN_EMAILS=owner@example.com
# Shared mode is invite-only: manage invites with
# `pnpm --filter @willgriffin/iolaus-site invite:add|invite:revoke|invite:list`.
# Uninvited users are told to request one here (email address or https URL).
# IOLAUS_INVITE_REQUEST_CONTACT=invites@example.com
# Shared mode only: public landing and legal links. https URLs only (support may
# also be an email). With a landing URL set, the root 302s there; otherwise it
# shows a sign-in entry. Unset links are simply hidden. App name comes from
# IOLAUS_APP_NAME.
# IOLAUS_PUBLIC_LANDING_URL=https://www.example.com/
# IOLAUS_TERMS_URL=https://www.example.com/terms
# IOLAUS_PRIVACY_URL=https://www.example.com/privacy
# IOLAUS_SUPPORT_URL=https://www.example.com/support
# Email magic-link sign-in instead of OIDC (shared, self-hosted profile only).
# IOLAUS_AUTH_MODE=magic-link
# IOLAUS_MAGIC_LINK_SECRET=
# ADDRESS_HEADER=X-Forwarded-For
# Invitation email (invite:add / invite:resend) over SMTP STARTTLS. SMTP_PORT
# defaults to 587; leave SMTP_* unset to invite without sending email.
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="Example <noreply@example.com>"
# DATABASE_URL=postgresql://career_hub:private-password@localhost:54329/career_hub
PRODUCTION_DATABASE_URL=
IOLAUS_BACKUP_DIR=
IOLAUS_PUBLIC_URL=
IOLAUS_OIDC_SERVER_URL=
# `realm` is the default. Root issuers use `root` with an origin-only server URL
# and no IOLAUS_OIDC_REALM; never use `..` as a realm value.
IOLAUS_OIDC_ISSUER_MODE=realm
IOLAUS_OIDC_REALM=
IOLAUS_OIDC_CLIENT_ID=
IOLAUS_OIDC_CLIENT_SECRET=
IOLAUS_OIDC_ADMIN_EMAILS=
# Migration export reads only an operator-verified isolated predecessor restore.
# Never point this at the live production database.
WILLGRIFFIN_MIGRATION_SOURCE_DATABASE_URL=
WILLGRIFFIN_MIGRATION_SOURCE_ISOLATED_RESTORE=false
# Asset planning reads only an isolated, restored asset backup passed as
# --source-assets. The import uses the same private RESUME_FILES_CONFIG_JSON
# configured for the self-hosted target; never set either to a checkout.
# Optional deployed storage override. Local profile assets use SMRT_DATA_DIR.
# RESUME_FILES_CONFIG_JSON={"type":"local","basePath":"/absolute/path"}
BIFROST_BASE_URL=https://models.example.invalid
BIFROST_API_KEY=
BIFROST_CHEAP_MODEL=openai/gpt-5.6-luna
BIFROST_CHEAP_TIMEOUT=105000
BIFROST_GOOD_MODEL=openai/gpt-5.6-terra
BIFROST_GOOD_TIMEOUT=105000
BIFROST_OPPORTUNITY_INTELLIGENCE_API_KEY=
OPPORTUNITY_INTELLIGENCE_PROFILE=openai
BIFROST_OPPORTUNITY_INTELLIGENCE_EXTRACTION_MODEL=openai/gpt-6-luna
BIFROST_OPPORTUNITY_INTELLIGENCE_EXTRACTION_TIMEOUT=105000
BIFROST_OPPORTUNITY_INTELLIGENCE_SCORING_MODEL=openai/gpt-6.1-sol
BIFROST_OPPORTUNITY_INTELLIGENCE_SCORING_TIMEOUT=105000
# AI opportunity intelligence and crawling are optional and remain disabled for
# local installs until the owner explicitly configures and enables them.
OPPORTUNITY_INTELLIGENCE_ENABLED=false
OPPORTUNITY_INTELLIGENCE_MAX_ENQUEUES_PER_CRAWL=0
OPPORTUNITY_INTELLIGENCE_MAX_INPUT_TOKENS=6000
OPPORTUNITY_INTELLIGENCE_MODEL_SCORING_ENABLED=false
OPPORTUNITY_INTELLIGENCE_CLEAR_ACCEPT_MIN_REQUIRED=0
OPPORTUNITY_INTELLIGENCE_CLEAR_REJECT_MIN_GAPS=0
OPPORTUNITY_INTELLIGENCE_SCORING_MAX_INPUT_TOKENS=3000
OPPORTUNITY_INTELLIGENCE_CRAWL_CALL_LIMIT=0
OPPORTUNITY_INTELLIGENCE_CRAWL_INPUT_TOKEN_LIMIT=0
OPPORTUNITY_INTELLIGENCE_CRAWL_SPEND_LIMIT_MICROS=0
OPPORTUNITY_INTELLIGENCE_RUN_CALL_LIMIT=0
OPPORTUNITY_INTELLIGENCE_RUN_INPUT_TOKEN_LIMIT=0
OPPORTUNITY_INTELLIGENCE_RUN_SPEND_LIMIT_MICROS=0
# GPT-6 opportunity-intelligence prices are pinned per profile in code.
# Hosted AI usage. Defaults leave private installs unchanged. Caps are
# micro-dollars (1000000 = $1) per user; 0 disables the cap. Shared mode records
# usage for every user; a cap is enforced before each provider call.
IOLAUS_AI_DISABLED=false
IOLAUS_AI_USER_LIFETIME_CAP_MICROS=0
IOLAUS_AI_USER_MONTHLY_CAP_MICROS=0
# Required for metered cover-letter writing and planning once a cap is set.
IOLAUS_AI_WRITING_INPUT_COST_MICROS_PER_MILLION=
IOLAUS_AI_WRITING_OUTPUT_COST_MICROS_PER_MILLION=
